<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.part3groupprojectcpsc233.app.MainController">
    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem fx:id="New" mnemonicParsing="false" onAction="#new_MenuItem" text="New" />
                        <MenuItem fx:id="Open" mnemonicParsing="false" onAction="#open_MenuItem" text="Open…" />
                        <MenuItem fx:id="Save" mnemonicParsing="false" onAction="#save_MenuItem" text="Save" />
                        <MenuItem fx:id="SaveAs" mnemonicParsing="false" onAction="#saveAs_MenuItem" text="Save As…" />
                        <MenuItem fx:id="Quit" mnemonicParsing="false" onAction="#quit_MenuItem" text="Quit" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#aboutPopup" text="About" />
                        <MenuItem mnemonicParsing="false" onAction="#controlsPopout" text="Controls" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Add">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#addPerson" text="Add Person" />
                        <MenuItem mnemonicParsing="false" onAction="#addPlayer" text="Register Player" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#addKills" text="Enter Kills" />
                        <MenuItem mnemonicParsing="false" onAction="#addAssists" text="Enter Assists" />
                        <MenuItem mnemonicParsing="false" onAction="#addDeaths" text="Enter Deaths" />
                        <MenuItem mnemonicParsing="false" onAction="#addADR" text="Enter ADR" />
                        <MenuItem mnemonicParsing="false" onAction="#addACS" text="Enter ACS" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" text="Form a Team" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Search Based on:">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#showHighestStats" text="Highest Stats" />
                        <MenuItem mnemonicParsing="false" onAction="#showOverAge" text="players Over Age" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="View:">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#changeMainViewToPeople" text="People" />
                        <MenuItem mnemonicParsing="false" onAction="#changeMainViewToPlayers" text="Players Based on Nationality" />
                        <MenuItem mnemonicParsing="false" onAction="#changeMainViewToTeams" text="based on Teams" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Get Recommended Team Based On:">
                    <items>
                        <MenuItem fx:id="GetRecommendedTeam" mnemonicParsing="false" onAction="#recommendedTeam" text="ACS" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0" VBox.vgrow="NEVER">
            <children>
                <Pane prefHeight="772.0" prefWidth="894.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="labelEurope" layoutX="351.0" text="Europe">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label layoutX="14.0" layoutY="308.0" text="Asia">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label layoutX="14.0" layoutY="54.0" text="Canada">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label layoutX="351.0" layoutY="184.0" text="USA">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="labelArgentina" layoutX="657.0" text="Argentina">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label layoutX="346.0" layoutY="375.0" text="Brazil">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="labelViewing" layoutX="6.0" text="Viewing: People">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="labelChile" layoutX="657.0" layoutY="184.0" text="Chile">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="labelStatus" layoutX="808.0" layoutY="539.0" text="Status">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>
                        <TextArea fx:id="textAreaEurope" editable="false" layoutX="302.0" layoutY="29.0" prefHeight="156.0" prefWidth="199.0" />
                        <TextArea fx:id="textAreaCanada" editable="false" layoutX="14.0" layoutY="83.0" prefHeight="156.0" prefWidth="199.0" />
                        <TextArea fx:id="textAreaAsia" editable="false" layoutX="14.0" layoutY="337.0" prefHeight="156.0" prefWidth="199.0" />
                        <TextArea fx:id="textAreaUSA" editable="false" layoutX="302.0" layoutY="213.0" prefHeight="156.0" prefWidth="199.0" />
                        <TextArea fx:id="textAreaBrazil" editable="false" layoutX="302.0" layoutY="404.0" prefHeight="156.0" prefWidth="199.0" />
                        <TextArea fx:id="textAreaArgentina" editable="false" layoutX="609.0" layoutY="29.0" prefHeight="156.0" prefWidth="199.0" />
                        <TextArea fx:id="textAreaChile" editable="false" layoutX="609.0" layoutY="213.0" prefHeight="156.0" prefWidth="199.0" />
                        <VBox layoutX="619.0" layoutY="381.0" prefHeight="130.0" prefWidth="162.0" style="-fx-background-color: azure;">
                            <children>
                                <Label id="&quot;" alignment="TOP_LEFT" prefHeight="18.0" prefWidth="265.0" text="Recommended Team" textAlignment="CENTER" />
                                <Label prefHeight="18.0" prefWidth="255.0" text="Username               ACS" />
                                <Label fx:id="Recommended1" prefHeight="18.0" prefWidth="135.0" />
                                <Label fx:id="Recommended2" prefHeight="18.0" prefWidth="135.0" />
                                <Label fx:id="Recommended3" prefHeight="18.0" prefWidth="135.0" />
                                <Label fx:id="Recommended4" prefHeight="18.0" prefWidth="135.0" />
                                <Label fx:id="Recommended5" prefHeight="18.0" prefWidth="135.0" />
                            </children>
                            <effect>
                                <Blend mode="SCREEN" />
                            </effect>
                        </VBox>
                  <TextArea fx:id="teamField" editable="false" layoutX="14.0" layoutY="18.0" prefHeight="523.0" prefWidth="537.0" visible="false" />
                    </children></Pane>
            </children>
            <padding>
                <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
            </padding>
        </HBox>
    </children>
</VBox>
